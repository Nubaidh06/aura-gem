<%- include('partials/header') %>

<div class="page-header">
  <h1><%= customer.name %>'s Account</h1>
  <p>Saved contact information, curated wishlist, and order history.</p>
</div>

<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; margin-bottom: 4rem;">
  <!-- Customer Details Card -->
  <div class="box-border" style="height: fit-content; border-top: 1px solid var(--border-color);">
    <h3 style="margin-bottom: 1.5rem; font-family: var(--font-heading); font-weight: normal; font-size: 1.5rem;">Contact &amp; Shipping</h3>
    <p style="margin-bottom: 0.75rem; font-size: 0.9rem;"><strong>Email:</strong> <%= customer.email %></p>
    <p style="margin-bottom: 0.75rem; font-size: 0.9rem;"><strong>Phone:</strong> <%= customer.phone %></p>
    
    <% if (customer.delivery_address) { %>
      <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
        <strong style="font-size: 0.9rem;">Shipping Address:</strong>
        <p style="color: var(--text-muted); margin-top: 0.5rem; font-size: 0.9rem; line-height: 1.6;">
          <%= customer.delivery_address.street %><br>
          <%= customer.delivery_address.city %>, <%= customer.delivery_address.state %> <%= customer.delivery_address.zip %>
        </p>
      </div>
    <% } %>

    <details style="margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
      <summary style="font-size: 0.82rem; font-weight: 600; color: var(--gold-dark); cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px;">
        Edit Details &amp; Address
      </summary>
      <form action="/customer/<%= customer._id %>/update" method="POST" style="margin-top: 1rem;">
        <div class="form-group" style="margin-bottom: 0.75rem;">
          <label style="font-size: 0.75rem; text-transform: uppercase;">Phone Number</label>
          <input type="text" name="phone" value="<%= customer.phone || '' %>" style="padding: 0.4rem; font-size: 0.85rem; width: 100%;">
        </div>
        <div class="form-group" style="margin-bottom: 0.75rem;">
          <label style="font-size: 0.75rem; text-transform: uppercase;">Street Address</label>
          <input type="text" name="street" value="<%= customer.delivery_address ? customer.delivery_address.street : '' %>" style="padding: 0.4rem; font-size: 0.85rem; width: 100%;">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.75rem;">
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem; text-transform: uppercase;">City</label>
            <input type="text" name="city" value="<%= customer.delivery_address ? customer.delivery_address.city : '' %>" style="padding: 0.4rem; font-size: 0.85rem; width: 100%;">
          </div>
          <div class="form-group" style="margin: 0;">
            <label style="font-size: 0.75rem; text-transform: uppercase;">State</label>
            <input type="text" name="state" value="<%= customer.delivery_address ? customer.delivery_address.state : '' %>" style="padding: 0.4rem; font-size: 0.85rem; width: 100%;">
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 0.75rem;">
          <label style="font-size: 0.75rem; text-transform: uppercase;">ZIP Code</label>
          <input type="text" name="zip" value="<%= customer.delivery_address ? customer.delivery_address.zip : '' %>" style="padding: 0.4rem; font-size: 0.85rem; width: 100%;">
        </div>
        <button type="submit" class="btn btn-secondary btn-sm" style="width: 100%; margin-top: 0.5rem;">Save Changes</button>
      </form>
    </details>
  </div>

  <!-- Wishlist Section -->
  <div>
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
      <h2 style="font-family: var(--font-heading); font-weight: normal; font-size: 2rem;">Saved Wishlist (<%= wishlistProducts.length %>)</h2>
    </div>

    <% if (wishlistProducts.length === 0) { %>
      <div class="box-border" style="text-align: center; color: var(--text-muted); padding: 4rem 2rem;">
        Your wishlist is currently empty. <a href="/catalog" style="text-decoration: underline;">Browse our collection</a> to save your favorite jewelry pieces.
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% wishlistProducts.forEach(product => { %>
          <div class="wishlist-item-card">
            <div style="display: flex; align-items: center; gap: 1.25rem;">
              <% if (product.image_url) { %>
                <img src="<%= product.image_url %>" alt="<%= product.name %>" class="cart-item-thumb">
              <% } %>
              <div>
                <h3 style="font-family: var(--font-heading); font-size: 1.15rem; margin-bottom: 0.25rem;">
                  <a href="/product/<%= product._id %>"><%= product.name %></a>
                </h3>
                <p style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                  <%= product.metal_type %> &bull; <%= product.gemstone %>
                </p>
                <div style="font-size: 1.05rem; font-weight: 600; color: var(--gold-dark); margin-top: 0.25rem;">
                  $<%= product.price.toLocaleString() %>
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 0.75rem; align-items: center;">
              <a href="/product/<%= product._id %>" class="btn btn-secondary btn-sm">View Piece</a>

              <!-- Remove from wishlist -->
              <form action="/customer/<%= customer._id %>/wishlist/remove" method="POST" style="margin: 0;">
                <input type="hidden" name="productId" value="<%= product._id %>">
                <button type="submit" class="btn btn-danger btn-sm" title="Remove from wishlist">Remove</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Past Orders Section -->
<div class="page-header" style="margin-top: 4rem;">
  <h2>Order History (<%= orders.length %>)</h2>
</div>

<% if (orders.length === 0) { %>
  <div class="box-border" style="text-align: center; color: var(--text-muted); padding: 4rem 2rem;">
    No orders placed yet.
  </div>
<% } else { %>
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    <% orders.forEach(order => { %>
      <div class="table-wrapper box-border" style="padding: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
          <div>
            <strong style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: normal;">Order #<%= order._id %></strong>
            <span style="color: var(--text-muted); font-size: 0.85rem; margin-left: 1rem; text-transform: uppercase; letter-spacing: 1px;">
              Date: <%= new Date(order.order_date).toLocaleDateString() %>
            </span>
          </div>
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; border: 1px solid var(--text-main); padding: 0.25rem 0.75rem;">
            Status: <%= order.status %>
          </span>
        </div>

        <table>
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Quantity</th>
              <th>Unit Price</th>
              <th>Line Total</th>
            </tr>
          </thead>
          <tbody>
            <% order.items.forEach(item => { %>
              <tr>
                <td><%= item.name %></td>
                <td><%= item.quantity %></td>
                <td>$<%= item.price_at_purchase.toLocaleString() %></td>
                <td>$<%= (item.price_at_purchase * item.quantity).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div style="display: flex; justify-content: flex-end; gap: 2.5rem; margin-top: 1.5rem; font-size: 0.95rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
          <div>Subtotal: <strong>$<%= order.subtotal.toLocaleString() %></strong></div>
          <div>Tax: <strong>$<%= order.tax.toLocaleString() %></strong></div>
          <div>Total: <strong style="font-size: 1.2rem;">$<%= order.total_price.toLocaleString() %></strong></div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
